#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repo_dir/scripts/tooling-env"
linker_dir="$tools_dir/linker"
if [ ! -f "$linker_dir/version.txt" ]; then
    echo "Local Zig linker is missing; see README.md." >&2
    exit 1
fi
version=$(cat "$linker_dir/version.txt")
export ZIG_GLOBAL_CACHE_DIR="$linker_dir/cache"
export ZIG_LOCAL_CACHE_DIR="$linker_dir/local-cache"
exec "$linker_dir/zig-x86_64-linux-$version/zig" cc "$@"
