#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
workspace_dir=$(CDPATH= cd -- "$repo_dir/../.." && pwd)
export CARGO_HOME="$workspace_dir/.tools/rust/cargo"
export RUSTUP_HOME="$workspace_dir/.tools/rust/rustup"
export PATH="$CARGO_HOME/bin:$PATH"
export CARGO_TARGET_DIR="$repo_dir/target"
if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    echo "Workspace-local Rust is missing. See $repo_dir/README.md for explicit setup." >&2
    exit 1
fi
exec "$CARGO_HOME/bin/cargo" "$@"
