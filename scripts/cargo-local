#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repo_dir/scripts/tooling-env"
if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    echo "Workspace-local Rust is missing. Run $repo_dir/scripts/setup explicitly." >&2
    exit 1
fi
# Use the explicitly installed local linker only when no host cc is available.
if ! command -v cc >/dev/null 2>&1 && [ -f "$tools_dir/linker/version.txt" ]; then
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$repo_dir/scripts/linker-local"
fi
exec "$CARGO_HOME/bin/rustup" run 1.99.1 cargo "$@"
